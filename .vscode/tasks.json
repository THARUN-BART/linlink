{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cargo",
      "command": "build",
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "rust: cargo build",
      "options": {
        "cwd": "${workspaceFolder}/linux-companion"
      }
    },
    {
      "type": "cargo",
      "command": "check",
      "problemMatcher": ["$rustc"],
      "label": "rust: cargo check",
      "options": {
        "cwd": "${workspaceFolder}/linux-companion"
      }
    },
    {
      "type": "cargo",
      "command": "test",
      "problemMatcher": ["$rustc"],
      "group": "test",
      "label": "rust: cargo test",
      "options": {
        "cwd": "${workspaceFolder}/linux-companion"
      }
    }
  ]
}
